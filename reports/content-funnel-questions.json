{
  "entryQuestions": [
    {
      "id": "Q1",
      "question": "为什么越来越多人觉得「明天不会比今天更好」？",
      "why": "最贴近普通人的生活感受，也是 X 上现实入口最有效的一类内容；读者不需要政治知识就能确认自己在经历什么。",
      "levels": ["L1", "L2", "L3"]
    },
    {
      "id": "Q2",
      "question": "为什么经济问题最后一定会变成政治问题？",
      "why": "把财政、地方债、制造业、社保这些可讨论的经济议题，自然引向「谁来决定、谁来负责」的政治问题。",
      "levels": ["L1", "L2"]
    },
    {
      "id": "Q3",
      "question": "中共为什么改不动？为什么还能修补政策，却已经无法完成路线改革？",
      "why": "网站存量最强的一类内容（中共机制与官僚困局），也是 X 上流量最大的主题；它天然以「那怎么办」收尾。",
      "levels": ["L1", "L2"]
    },
    {
      "id": "Q4",
      "question": "如果中共突然出问题，中国第二天怎么办？",
      "why": "绝大多数读者都想过但没有答案的问题，直接对应「国家连续性」这条路线主张。",
      "levels": ["L1", "L2", "L3"]
    },
    {
      "id": "Q5",
      "question": "为什么体制内的人也是政治转轨必须考虑的一部分？",
      "why": "X 数据里互动最强的桥梁主题（官僚不必倒戈）；它同时回答了「转轨会不会清算到我」。",
      "levels": ["L1", "L2", "L3"]
    },
    {
      "id": "Q6",
      "question": "为什么不能等它自己崩，也不能靠革命解决？",
      "why": "读者最容易把「反对现状」自动等同于革命或等待；这里是公民秩序主义与一般反对叙事的分界点。",
      "levels": ["L2", "L3"]
    },
    {
      "id": "Q7",
      "question": "为什么「不清算」不是心软，而是路线的一部分？",
      "why": "最容易被误读的政治立场；澄清它，读者才会理解路线为什么强调降低阻力而不是报复。",
      "levels": ["L3", "L4"]
    },
    {
      "id": "Q8",
      "question": "一个新的政治力量凭什么值得信任？政治信誉怎么证明？",
      "why": "X 数据显示「为什么需要信誉」互动率高、而直接招募互动率低；这是把认同转成长期关系的关键问题。",
      "levels": ["L3", "L4"]
    },
    {
      "id": "Q9",
      "question": "政治变化之后，普通人的生活、工资、养老金、医院、秩序会怎么样？",
      "why": "读者对「变化」最具体的恐惧；也是「保留国家」这条主张最需要被兑现的部分。",
      "levels": ["L3", "L4"]
    },
    {
      "id": "Q10",
      "question": "这跟我有什么关系？我为什么要关心一条还没发生的政治转轨？",
      "why": "从理解转向参与的最后一道门；决定读者是「读过」还是「留下来」。",
      "levels": ["L3", "L4"]
    }
